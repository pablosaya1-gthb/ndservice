---
// Marco para foto real pendiente. Cuando el cliente entregue las fotos
// se reemplaza este componente por <img src="/fotos/....jpg" alt="...">.
interface Props {
  label: string;
  icon?: string;
  ratio?: string;
  class?: string;
}

const { label, icon = 'wrench', ratio = '4 / 3', class: className = '' } = Astro.props;
---

<div
  class={`media-ph ${className}`.trim()}
  style={`aspect-ratio: ${ratio};`}
  role="img"
  aria-label={label}
>
  <span class="media-ph-tag">
    <svg class="icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7.5h3.2L9 5h6l1.8 2.5H20a1.5 1.5 0 0 1 1.5 1.5v9a1.5 1.5 0 0 1-1.5 1.5H4A1.5 1.5 0 0 1 2.5 18V9A1.5 1.5 0 0 1 4 7.5z"/><circle cx="12" cy="13" r="3.4"/></svg>
    Foto
  </span>
  <svg class="icon" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    {icon === 'washing' && <><rect x="3.5" y="2.5" width="17" height="19" rx="3"/><circle cx="12" cy="13.5" r="5.3"/><path d="M9 15.6c1.8 1.3 4.2 1.3 6 0"/></>}
    {icon === 'dryer' && <><rect x="3.5" y="2.5" width="17" height="19" rx="3"/><circle cx="12" cy="13.5" r="5.3"/></>}
    {icon === 'dishwasher' && <><rect x="3.5" y="2.5" width="17" height="19" rx="3"/><path d="M8 12.5v5M12 12.5v5M16 12.5v5"/></>}
    {icon === 'microwave' && <><rect x="2.5" y="5" width="19" height="14" rx="2.5"/><rect x="5" y="8" width="9.5" height="8" rx="1"/></>}
    {icon === 'oven' && <><rect x="3.5" y="2.5" width="17" height="19" rx="3"/><rect x="6.5" y="11.5" width="11" height="6.5" rx="1.5"/></>}
    {icon === 'cooktop' && <><rect x="3" y="3" width="18" height="18" rx="3.5"/><circle cx="9" cy="9.5" r="3.4"/><circle cx="16" cy="15.5" r="2.8"/></>}
    {icon === 'wrench' && <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>}
  </svg>
  <span class="media-ph-label">{label}</span>
</div>
