---
import { zones, site, waLink } from '../data/site';
import Icon from './Icon.astro';
---

<section class="section" id="cobertura" aria-labelledby="zones-title">
  <div class="container">
    <div class="zones-grid">
      <div class="reveal">
        <div class="section-head" style="margin-bottom: 20px;">
          <p class="eyebrow">Zonas de atención</p>
          <h2 class="section-title" id="zones-title">¿Atendemos en tu zona?</h2>
          <p class="section-sub">
            Salimos desde El Palomar con cobertura amplia en la Ciudad y el Gran Buenos Aires.
          </p>
        </div>

        <ul class="zone-list">
          {
            zones.map((z) => (
              <li class="zone-item">
                <span class="zone-icon"><Icon name="pin" size={20} /></span>
                <div>
                  <strong>{z.name}</strong>
                  <span>{z.detail}</span>
                </div>
              </li>
            ))
          }
        </ul>

        <div class="zones-note">
          <p>
            ¿Dudas si cubrimos tu barrio? Escribinos con tu zona y te confirmamos en el momento.
          </p>
          <a class="btn btn-ghost btn-sm" href={waLink('Hola, quiero saber si atienden en mi zona. Vivo en: ')} target="_blank" rel="noopener">
            <Icon name="whatsapp" size={17} /> Consultar mi zona
          </a>
        </div>
      </div>

      <figure class="zones-map reveal" style="margin: 0;">
        <img
          src={site.map}
          alt="Mapa esquemático de cobertura: Zona Oeste hasta Moreno y San Miguel, Zona Norte hasta Tigre, Zona Sur hasta Canning y Quilmes, y CABA, con base de operaciones en El Palomar"
          width="640"
          height="560"
          loading="lazy"
        />
        <figcaption class="sr-only">Mapa esquemático, no a escala.</figcaption>
      </figure>
    </div>
  </div>
</section>
