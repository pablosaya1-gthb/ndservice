---
import { stats } from '../data/site';
---

<section class="stats-band" aria-label="Cifras de N/D Service">
  <div class="container">
    <!-- Cifra protagonista con ícono animado (llave "apretando el tornillo") -->
    <div class="stat-hero reveal" role="img" aria-label="Más de 1500 servicios realizados">
      <span class="stat-hero-badge" aria-hidden="true">
        <svg
          class="stat-hero-icon"
          width="30"
          height="30"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path
            d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"
          />
        </svg>
      </span>
      <span class="stat-hero-num">+1.500</span>
      <span class="stat-hero-label">servicios realizados</span>
    </div>

    <div class="stats-grid">
      {
        stats
          .filter((s) => s.label !== 'servicios realizados')
          .map((s) => (
            <div class="reveal">
              <div class="stat-value">{s.value}</div>
              <div class="stat-label">{s.label}</div>
            </div>
          ))
      }
    </div>
  </div>
</section>
