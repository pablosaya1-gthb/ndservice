---
import { stats } from '../data/site';
---

<section class="stats-band" aria-label="Cifras de N/D Service">
  <div class="container">
    <!-- Cifra protagonista con ícono animado (llave "apretando el tornillo") -->
    <div class="stat-hero reveal" role="img" aria-label="Más de 1500 servicios realizados">
      <span class="stat-hero-badge" aria-hidden="true">
        <svg
          class="stat-hero-icon"
          width="30"
          height="30"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path
            d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"
          />
        </svg>
      </span>
      <span class="stat-hero-num">+1.500</span>
      <span class="stat-hero-label">servicios realizados</span>
    </div>

    <div class="stats-grid">
      {
        stats
          .filter((s) => s.label !== 'servicios realizados')
          .map((s) => (
            <div class="reveal stat-cell">
              <span class={`stat-icon-badge stat-icon-${s.icon}`} aria-hidden="true">
                {s.icon === 'clock' && (
                  <svg
                    width="22"
                    height="22"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <circle cx="12" cy="12" r="8.5" />
                    <path d="M12 12 8.8 10.4" />
                    <path class="clock-hand" d="M12 12V6.5" />
                  </svg>
                )}
                {s.icon === 'pin' && (
                  <svg
                    width="22"
                    height="22"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
                    <circle cx="12" cy="10" r="3" />
                  </svg>
                )}
                {s.icon === 'tag' && (
                  <svg
                    width="22"
                    height="22"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path
                      d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"
                    />
                    <circle cx="7.5" cy="7.5" r=".5" fill="currentColor" />
                  </svg>
                )}
              </span>
              <div class="stat-value">{s.value}</div>
              <div class="stat-label">{s.label}</div>
            </div>
          ))
      }
    </div>
  </div>
</section>
